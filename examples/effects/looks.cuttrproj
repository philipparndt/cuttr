# The look family: film mode, the tape, and chromatic aberration.
#
# These three work on the *picture*, and a flat card gives them nothing to work
# on — so the picture here is made of effects. Confetti and rain are drawn into
# the frame, in the same pass, which means the film, the tape and the aberration
# all take hold of them. Over your own footage it is exactly the same three
# overlays; point `takes:` at a take and put a clip on the timeline instead.
#
#   cuttr-render examples/effects/looks.cuttrproj
#
# The order of `overlays:` is the order they are drawn, and that is the whole
# control over what sits on top of what. An aberration written *before* the film
# overlay is under its letterbox, so the bars stay clean; written after it, the
# bars are bent along with everything else. Move a row in the panel to change it.
cuttr-project: 1

output:
  size: 1920x1080
  fps:  25
  file: looks.mov

timeline:
  - card:  00:05.000
    as:    shot
    fill:  ["#243447", "#080c12"]

overlays:
  # The picture: something for the three of them to get hold of. Written first,
  # so everything after it is working on top of it.
  - effect:  confetti
    density: 1.4
    size:    1.2
    seed:    4
    from:    "@shot"
    in:      {fade: true, over: 0.3}
    out:     {fade: true, over: 0.5}
  - effect:  rain
    density: 1.2
    speed:   1.2
    wind:    0.4
    from:    "@shot"
    in:      {fade: true, over: 0.3}
    out:     {fade: true, over: 0.5}

  # Under the film: the fringing is on the picture, and the bars that close over
  # it are untouched.
  - aberration: radial
    amount:     0.8
    from:       "@shot"
    in:         {fade: true, over: 0.6}
    out:        {fade: true, over: 0.6}

  - film:     warm        # none · warm · cool · sepia · noir · bleach
    ratio:    "2.39:1"
    strength: 0.8
    grain:    0.45
    vignette: 0.35
    from:     "@shot"
    in:       {fade: true, over: 1}
    out:      {fade: true, over: 1}

  # Over the film: the tape disturbs the bars as well, because a tape is the
  # whole picture including its edges. Write it above the film for that, below
  # for a clean letterbox around a worn picture.
  - tape:  chewed         # clean · worn · chewed
    seed:  3
    from:  "@shot"
    in:    {fade: true, over: 0.3}
    out:   {fade: true, over: 0.3}
