<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>cuttr</string>
	<key>CFBundleDisplayName</key>
	<string>cuttr</string>
	<key>CFBundleIdentifier</key>
	<string>de.rnd7.cuttr</string>
	<key>CFBundleExecutable</key>
	<string>cuttr</string>
	<key>CFBundleIconFile</key>
	<string>cuttr</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.video</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Philipp Arndt</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Dark by default; the timeline is drawn against a fixed dark palette. -->
	<key>NSRequiresAquaSystemAppearance</key>
	<false/>
	<!-- Transcribing a take. The sentence is what somebody reads in the
	     permission alert, so it says the thing they will want to know: this
	     happens here, on their Mac, and the footage is not going anywhere.
	     Required by `SFSpeechRecognizer`, which is the fallback on a system
	     without `SpeechAnalyzer`; the app would be killed for asking without
	     it. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>cuttr transcribes a take on this Mac, so you can cut it by selecting the words. Nothing is uploaded.</string>
	<!-- Recording a screencast. macOS grants screen recording in System
	     Settings rather than in a prompt, so this string is what somebody reads
	     in the list there beside cuttr's name — which is the one place they
	     will be deciding whether to allow it, possibly weeks after the app
	     asked. It says what is recorded, which is one window rather than their
	     screen. -->
	<key>NSScreenCaptureUsageDescription</key>
	<string>cuttr records the browser window it opened for you, so a screencast can be made without anything else on your screen appearing in it.</string>
	<!-- The cut list. Declared so that a double-click opens it here and so
	     that the open panel can filter to it; it is UTF-8 YAML, and the
	     conformance says so rather than pretending it is opaque. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>cuttr project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>de.rnd7.cuttr.project</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>cuttr take</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>de.rnd7.cuttr.take</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>de.rnd7.cuttr.project</string>
			<key>UTTypeDescription</key>
			<string>cuttr project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.utf8-plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cuttrproj</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>de.rnd7.cuttr.take</string>
			<key>UTTypeDescription</key>
			<string>cuttr take</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.utf8-plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cuttr</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
